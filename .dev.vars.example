# Secret used to create the owner of this instance (first run) and to mint a
# recovery owner key later:
#   curl -X POST <worker URL>/api/v1/setup -H "Authorization: Bearer <ADMIN_BOOTSTRAP_KEY>"
# Generate one with: openssl rand -hex 32
ADMIN_BOOTSTRAP_KEY=

# HMAC secret for signed links, password cookies and IP hashing. When unset, the
# signing key is derived from ADMIN_BOOTSTRAP_KEY instead of reusing it; set its
# own value so rotating that key does not sign everyone out. Generate one with:
# openssl rand -hex 32
SIGNING_SECRET=
