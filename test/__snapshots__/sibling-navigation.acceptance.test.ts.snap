exports[`same-folder sibling navigation > omits navigation and preserves baseline output for a single-file folder and embeds > alone/only.csv 1`] = `
"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>only.csv · sibling-navigation-fixture</title><style>
:root{color-scheme:light dark;--bg:#fbfaf8;--fg:#1d1b19;--muted:#6b665f;--line:#e6e1da;--card:#fff;--accent:#d9480f;--code:#f3f0eb}
@media (prefers-color-scheme:dark){:root{--bg:#141312;--fg:#ece8e2;--muted:#a19a90;--line:#2c2a27;--card:#1b1a18;--accent:#ff8a4c;--code:#22201d}}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.6 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
a{color:var(--accent)}code,pre,kbd{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.9em}
.dw-bar{position:sticky;top:0;z-index:5;display:flex;gap:.75rem;align-items:center;justify-content:space-between;padding:.55rem 1rem;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);font-size:.85rem}
.dw-bar .dw-path{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dw-bar nav{display:flex;gap:.5rem;flex-shrink:0}
.dw-bar nav a{padding:.2rem .6rem;border:1px solid var(--line);border-radius:999px;text-decoration:none;color:var(--fg)}
.dw-bar nav a:hover{border-color:var(--accent);color:var(--accent)}
.dw-system{max-width:34rem;margin:18vh auto;padding:0 1.25rem;text-align:left}
.dw-system h1{font-size:1.6rem;line-height:1.2;margin:0 0 .5rem}.dw-system p{color:var(--muted);margin:.25rem 0 1rem}
.dw-system .dw-code{display:inline-block;font:600 .8rem/1 ui-monospace,monospace;letter-spacing:.06em;color:var(--accent);margin-bottom:.75rem}
input,button{font:inherit}

[hidden]{display:none!important}
.dw-vbar{position:sticky;top:0;z-index:20;display:flex;flex-wrap:wrap;gap:.4rem .9rem;align-items:center;justify-content:space-between;padding:.45rem .9rem;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);font-size:.82rem;line-height:1.3}
.dw-vfile{display:flex;align-items:center;gap:.6rem;min-width:0;flex:1 1 18rem}
.dw-kind{flex:none;font:600 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em;text-transform:uppercase;color:var(--accent);border:1px solid color-mix(in srgb,var(--accent) 40%,transparent);border-radius:4px;padding:.25rem .4rem}
.dw-crumbs{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.dw-crumbs a{color:var(--muted);text-decoration:none}.dw-crumbs a:hover{color:var(--accent)}.dw-crumbs strong{font-weight:600;color:var(--fg)}
.dw-sep{color:var(--muted);opacity:.5;padding:0 .2rem}
.dw-vmeta{flex:none;color:var(--muted);white-space:nowrap}
.dw-vtabs{display:flex;border:1px solid var(--line);border-radius:7px;overflow:hidden;flex:none}
.dw-vtabs a{padding:.28rem .7rem;text-decoration:none;color:var(--muted);border-left:1px solid var(--line)}
.dw-vtabs a:first-child{border-left:0}.dw-vtabs a:hover{color:var(--fg);background:var(--code)}
.dw-vtabs a[aria-current]{color:var(--fg);background:var(--card);font-weight:600;box-shadow:inset 0 -2px 0 var(--accent)}
.dw-vact{display:flex;gap:.4rem;flex:none;align-items:center;flex-wrap:wrap;max-width:100%}
.dw-phone summary{list-style:none}.dw-phone summary::-webkit-details-marker{display:none}
.dw-phone summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.dw-phone-panel{position:absolute;right:.6rem;top:100%;width:min(20rem,calc(100vw - 1.2rem));box-sizing:border-box;padding:1rem;border:1px solid var(--line);border-radius:8px;background:var(--card);box-shadow:0 .5rem 1.5rem #0003;max-height:calc(100dvh - 8rem);overflow:auto}
.dw-phone-panel p{margin:0 0 .75rem}.dw-phone-panel svg{display:block;width:256px;max-width:100%;height:auto;margin:0 auto .75rem}
.dw-vact .dw-phone-panel a{display:block;overflow-wrap:anywhere;white-space:normal;padding:0;border:0;border-radius:0;background:none;color:var(--accent);text-decoration:underline;user-select:text}
.dw-vact a,.dw-vact label,.dw-phone summary,.dw-btn{padding:.28rem .65rem;border:1px solid var(--line);border-radius:7px;text-decoration:none;color:var(--fg);background:var(--card);cursor:pointer;font-size:.82rem;line-height:1.3;user-select:none}
.dw-vact a:hover,.dw-vact label:hover,.dw-btn:hover{border-color:var(--accent);color:var(--accent)}
.dw-toggle{position:absolute;opacity:0;pointer-events:none}
.dw-toggle:focus-visible+label{outline:2px solid var(--accent);outline-offset:2px}
.dw-note{margin:.75rem auto;max-width:60rem;padding:.55rem .85rem;border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:7px;background:var(--card);font-size:.85rem;color:var(--muted)}
.dw-note a{color:var(--accent)}
.dw-checker{background-color:var(--card);background-image:linear-gradient(45deg,var(--code) 25%,transparent 25%),linear-gradient(-45deg,var(--code) 25%,transparent 25%),linear-gradient(45deg,transparent 75%,var(--code) 75%),linear-gradient(-45deg,transparent 75%,var(--code) 75%);background-size:20px 20px;background-position:0 0,0 10px,10px -10px,-10px 0}
.dw-meta{color:var(--muted);font-size:.85rem;text-align:center;margin:.75rem 0}
@media (max-width:640px){.dw-vmeta{display:none}.dw-vbar{padding:.4rem .6rem}}

.dw-csv{padding:.6rem .9rem 3rem}
.dw-csvmeta{font-size:.82rem;color:var(--muted);margin:.2rem 0 .6rem}
.dw-table{overflow:auto;max-height:calc(100vh - 7.5rem);border:1px solid var(--line);border-radius:9px;background:var(--card)}
.dw-table table{border-collapse:separate;border-spacing:0;font-size:.84rem;min-width:100%}
.dw-table th,.dw-table td{padding:.32rem .7rem;border-bottom:1px solid var(--line);border-right:1px solid var(--line);white-space:nowrap;max-width:28rem;overflow:hidden;text-overflow:ellipsis;vertical-align:top;text-align:left}
.dw-table thead th{position:sticky;top:0;background:var(--code);font-weight:600;z-index:1}
.dw-table td.n{text-align:right;font-variant-numeric:tabular-nums}
.dw-table th.rn,.dw-table td.rn{position:sticky;left:0;background:var(--code);color:var(--muted);text-align:right;font-weight:400;font-variant-numeric:tabular-nums;user-select:none}
.dw-table thead th.rn{z-index:2}
.dw-table tbody tr:hover td{background:color-mix(in srgb,var(--accent) 6%,transparent)}

