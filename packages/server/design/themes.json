{
  "version": 1,
  "about": "Kofra Security Print colour tokens for the public core. Two modes: light = the original k03 palette, dark = Midnight Intaglio; Auto (the default) follows prefers-color-scheme. Source of truth for scripts/build-design.mjs. Archived colourways are not part of the core (see the design prototype folder). Syntax tokens are checked at 4.5:1 on paper, paper-2 and paper-3.",
  "modes": {
    "default": "auto",
    "light": "original",
    "dark": "midnight-intaglio"
  },
  "tokens": [
    "paper",
    "paper-2",
    "paper-3",
    "surface",
    "field",
    "ink",
    "ink-2",
    "muted",
    "rule",
    "edge",
    "accent",
    "accent-hover",
    "accent-ink",
    "accent-2",
    "signal",
    "success",
    "warning",
    "warning-wash",
    "danger",
    "focus",
    "shadow",
    "eng-1",
    "eng-2",
    "eng-3",
    "eng-mark",
    "eng-frame"
  ],
  "syntaxTokens": [
    "syn-comment",
    "syn-keyword",
    "syn-string",
    "syn-number",
    "syn-title",
    "syn-type",
    "syn-tag",
    "syn-meta",
    "syn-del",
    "syn-del-wash",
    "syn-add",
    "syn-add-wash"
  ],
  "schemes": [
