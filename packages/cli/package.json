{
  "name": "kofra",
  "version": "0.1.0",
  "description": "Publish files, folders and sites to a live URL on any Kofra instance. Built for AI agents: one command, JSON output, content-addressed uploads.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "kofra",
    "dropway",
    "hosting",
    "static-site",
    "publish",
    "deploy",
    "cloudflare",
    "ai-agents",
    "mcp",
    "cli"
  ],
  "homepage": "https://github.com/TogetherWeOwn/dropway/tree/main/packages/cli#readme",
  "bugs": "https://github.com/TogetherWeOwn/dropway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TogetherWeOwn/kofra.git",
    "directory": "packages/cli"
  },
  "bin": {
    "kofra": "bin/dropway.mjs",
    "dropway": "bin/dropway.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/dropway.mjs --legal-comments=none",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run -c vitest.config.ts"
  },
  "devDependencies": {
    "@dropway/client": "^0.1.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3"
  }
}
